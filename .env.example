MONGODB_URI=mongodb+srv://user:password@cluster.example.net/
MONGODB_AUTH_DB=test
# If local SRV DNS fails, use a standard mongodb:// Atlas seed list in .env.local.
NOTE_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=KeepText <noreply@yourdomain.com>
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
